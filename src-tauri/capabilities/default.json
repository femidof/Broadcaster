{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Broadcaster",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/broadcaster-sidecar", "sidecar": true },
        { "name": "binaries/ffmpeg", "sidecar": true }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "updater:default"
  ]
}
